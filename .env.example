# Copie para .env.local (nunca commite o .env.local) e preencha.
# Na Vercel: Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API. Use SÓ a chave "anon" / publishable.
# A "service_role" nunca vai para variável NEXT_PUBLIC_: ela ignora o RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Slug da loja na tabela "lojas" (um deploy por loja).
NEXT_PUBLIC_LOJA_SLUG=eg-motors

# Endereço público do site, sem barra no final (sitemap, feed e SEO).
NEXT_PUBLIC_SITE_URL=https://egmotorsrn.com
